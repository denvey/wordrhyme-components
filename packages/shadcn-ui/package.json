{
  "name": "@wordrhyme/shadcn-ui",
  "type": "module",
  "version": "2.1.1",
  "packageManager": "pnpm@10.33.0",
  "description": "Custom UI components and utilities built with shadcn/ui.",
  "author": "m.doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/denvey/wordrhyme-components",
    "directory": "packages/shadcn-ui"
  },
  "bugs": {
    "url": "https://github.com/denvey/wordrhyme-components/issues"
  },
  "sideEffects": false,
  "exports": {
    "./tailwind.css": "./dist/tailwind.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "shadcn-ui-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./tailwind.css": "./dist/tailwind.css",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./styles.css": "./dist/styles.css"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "git clean -xdf .cache .turbo dist node_modules",
    "build": "pnpm run mcp:generate && tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "mcp:generate": "tsx ../mcp/src/generate-mcp-registry-cli.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ebay/nice-modal-react": "^1.2.13",
    "@iconify-json/fa": "catalog:prod",
    "@iconify-json/mdi": "catalog:prod",
    "@iconify/react": "catalog:prod",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pixpilot/hash": "catalog:prod",
    "@pixpilot/string": "catalog:prod",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-slot": "catalog:prod",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extensions": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@wordrhyme/shadcn": "workspace:*",
    "class-variance-authority": "catalog:prod",
    "dayjs": "^1.11.21",
    "lucide-react": "catalog:prod",
    "next-themes": "catalog:prod",
    "pretty-bytes": "^7.1.0",
    "react-responsive": "^10.0.1",
    "sonner": "2.0.7",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/hooks": "workspace:*",
    "@internal/mcp": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@storybook/react": "catalog:dev",
    "@storybook/test": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "eslint": "catalog:dev",
    "jsdom": "catalog:dev",
    "postcss": "catalog:dev",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "tailwindcss": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "prettier": "@internal/prettier-config",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
